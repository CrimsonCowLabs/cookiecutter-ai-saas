# Reverse proxy and TLS for {{ cookiecutter.project_name }}.
#
# Caddy runs inside docker-compose.prod.yml, on the host's own network, and is
# the only thing in the stack listening on a public address, so
# `docker compose -f docker-compose.prod.yml up -d` is all it takes to serve
# HTTPS. Caddy obtains a certificate from Let's Encrypt on first boot, renews it
# before it expires, and redirects HTTP to HTTPS itself.
#
# Host networking is what lets it see each client's real address rather than a
# Docker gateway's: see the caddy service in docker-compose.prod.yml.
#
# Before the first deploy, point the domain's A/AAAA record at this host.
# Issuance is a challenge against that name, so it fails until DNS resolves and
# ports 80 and 443 reach this host.
{#- Every Jinja tag in this file trims its own newline (`{%-`, `-%}`). That is
    load-bearing, not tidiness: a bare `{% %}` leaves the blank line its tag
    occupied, and CI diffs the rendered file against `caddy fmt`, which rejects
    a stray blank line before the global block.

    The ACME account address is emitted only for an address that could actually
    receive mail. RFC 2606 reserves example.com/.org/.net and the .test,
    .invalid, .localhost and .example TLDs; a suffix test on "example.com"
    would also wrongly suppress a real domain like acme-example.com. -#}
{%- set _email = cookiecutter.author_email.strip() -%}
{%- set _domain = _email.rpartition('@')[2].lower() if '@' in _email else '' -%}
{%- set _reserved_domains = ('example.com', 'example.org', 'example.net') -%}
{%- set _reserved_tlds = ('test', 'invalid', 'localhost', 'example', 'local') -%}
{%- if _domain and '.' in _domain and _domain not in _reserved_domains and _domain.rpartition('.')[2] not in _reserved_tlds %}
{
	# ACME account address. The certificate authority mails renewal failures
	# and expiry warnings here; it is never served to anyone.
	email {{ cookiecutter.author_email }}
}
{%- else %}

# There is no ACME account address: the address answered at generation time is
# at a reserved example domain, so no mail can reach it and a certificate
# authority can reject one it cannot deliver to. Certificates are still issued — the account is simply anonymous,
# so nobody is told when renewal starts failing. Add a global block once you
# have a real address:
#
#     {
#         email you@your-real-domain.com
#     }
{%- endif %}

# The site this proxy serves, with a publicly trusted certificate:
#
#     https://{{ cookiecutter.domain_name }}
#
# SITE_ADDRESS overrides that name, which is how you smoke-test the stack before
# DNS exists: set it to https://localhost and Caddy issues from its own local CA
# rather than asking Let's Encrypt for a name that does not resolve yet.
# Everything else — the redirect, TLS termination, the proxy hop — is unchanged.
{$SITE_ADDRESS:https://{{ cookiecutter.domain_name }}} {
	# The app publishes port 3000 on the host's loopback only, so this proxy
	# is the only route in from outside. Caddy sets X-Forwarded-For/-Proto/-Host
	# itself, which is what lets NextAuth (trustHost: true in
	# lib/auth.config.ts) build https:// callbacks — and X-Forwarded-For carries
	# the client's real address, which the contact form rate-limits by.
	reverse_proxy 127.0.0.1:3000

	# ── Scanner probes ──────────────────────────────────────────────────────
	# Bots walk every public address asking for leaked secrets and for admin
	# pages of software this app does not run. None of these paths can mean
	# anything to a Next.js app, so they are answered here — an empty 404, then
	# the connection is closed — and never cost the app a render or a log line.
	#
	# `*.php` covers most of WordPress on its own; the WordPress, phpMyAdmin
	# and CGI prefixes stay listed because they also catch the non-.php files
	# under them. Matching is case-insensitive, so /.ENV is blocked too.
	# Nothing here may overlap a real route: /.well-known/ (ACME, security.txt)
	# is deliberately absent, and a page whose path merely contains "php" or
	# "env" is not matched.
	@scanner path /.env* /.git /.git/* /.aws/* /.ssh/* /wp-login.php /wp-admin* /wp-content/* /wp-includes/* /xmlrpc.php /phpmyadmin* /pma/* /cgi-bin/* /server-status /server-info *.php
	handle @scanner {
		# The marker a ban jail matches on: `"blocked":"scanner"` in this
		# request's access-log line. A 404 alone would not do — the app
		# returns plenty of honest 404s.
		log_append blocked scanner
		respond 404 {
			close
		}
	}

	# ── Request body caps ───────────────────────────────────────────────────
	# Several route handlers read the whole body into memory before looking
	# at it (`req.json()`, `req.formData()`, `req.arrayBuffer()`), and some of
	# them take anonymous traffic. Caddy counts the bytes as they stream past
	# and answers 413 once a body goes over its cap, so an oversized upload
	# is refused before Node buffers it.
	#
	# Everything gets the generous cap. Nothing in the app accepts uploads;
	# the largest legitimate bodies are Stripe webhook events (well under a
	# megabyte) and server actions, which Next itself limits to 1 MB. Raise
	# this if you add file uploads, or give the upload route its own cap.
	request_body {
		max_size 10MB
	}

	# Small form posts get a tight cap. The contact form's longest valid
	# submission (a 5000-character message plus the other fields, see
	# lib/validations.ts) is around 20 KB even in four-byte UTF-8; the age
	# check posts a date and two short fields; one-click unsubscribe posts a
	# single fixed field. A route absent from this build (no contact form, say)
	# simply never matches.
	@small_form path /api/contact /api/age-check /api/unsubscribe
	request_body @small_form {
		max_size 64KB
	}

	# The analytics proxy (app/ingest/[...path]/route.ts) is unauthenticated
	# and forwards whatever it is sent. posthog-js posts batches of events,
	# compressed, and session recording is off (lib/analytics.ts), so a batch
	# stays far below this.
	@ingest path /ingest /ingest/*
	request_body @ingest {
		max_size 1MB
	}

	# A body cut off at its cap surfaces here as an error, not as a response
	# from the app, so this only ever fires for Caddy's own refusals: a 413
	# the app itself returned does not pass through it. It marks the line the
	# same way the scanner block does.
	handle_errors 413 {
		log_append blocked body_too_large
		respond 413 {
			close
		}
	}

	# ── Rate limits ─────────────────────────────────────────────────────────
	# Each client address gets a budget of requests per sliding window, so one
	# source flooding the site is slowed here, before Next, Postgres or the
	# LLM bill notices. The directive is not stock Caddy: it is the
	# caddy-ratelimit module, compiled into the image caddy/Dockerfile builds,
	# and it orders itself ahead of `handle`, so it runs before everything
	# below — scanner probes are counted too.
	#
	# The key is {remote_host}, the address the connection came from. That is
	# the client's own because Caddy is on the host's network (see the top of
	# this file); it would be a Docker gateway's, and every client would share
	# one budget, if Caddy were ever moved behind published ports or another
	# proxy. An IPv6 client is limited by its /64, the block one subscriber is
	# typically handed, so cycling through addresses inside it buys nothing.
	#
	# Every limit is read from the environment, with the default after the
	# colon, so it can be tuned in the deploy's environment rather than here.
	# A request that matches several zones spends from each. A refusal is a
	# 429 with Retry-After (the seconds until the window frees a slot), and is
	# marked in the access log below.
	rate_limit {
		# General: every request but the exempt and ingest routes below. A
		# cold page load is one document plus a few dozen /_next/static
		# chunks, fonts and images, and <Link> prefetches an RSC payload for
		# every link in view; those are all counted, since they all reach
		# Next. Repeat visits load the hashed chunks from the browser's cache
		# (they are served immutable), so it is the first load that sets the
		# floor. 100 per 10 s is several cold loads at once, then ten
		# requests a second sustained — far past one person browsing, and a
		# refused one is never locked out for more than ten seconds. Raise it
		# if many of your users share one address (an office, a school,
		# carrier-grade NAT).
		#
		# Exempt: the job-progress stream is one long request per job, held
		# by a signed-in user, that EventSource reopens by itself whenever it
		# drops, so limiting it only breaks a page already being watched;
		# and the Stripe webhook arrives from Stripe's handful of addresses,
		# in bursts when it retries, and a refused delivery is a billing
		# event the app may never see. Both are authenticated (a session, a
		# signature) before they do any work.
		zone general {
			match {
				not path /api/jobs/*/progress /api/webhook/stripe /ingest /ingest/*
			}
			key {remote_host}
			ipv6_prefix 64
			events {$CADDY_RATE_LIMIT_EVENTS:100}
			window {$CADDY_RATE_LIMIT_WINDOW:10s}
		}

		# Strict: the requests that cost real money or mail somebody, which
		# nobody legitimate sends more than a few times a minute. Each is its
		# own zone on the same limit, so a user who just signed in still has
		# the whole budget for submitting jobs. 10 a minute is a person
		# retrying a typo'd address or a failed submission, with room over.
		#
		# Sign-in: next-auth's signIn() POSTs /api/auth/signin/<provider>.
		# For the email provider that sends a magic link, to any address the
		# form is given; for OAuth it starts a round trip to the provider.
		zone sign_in {
			match {
				method POST
				path /api/auth/signin/*
			}
			key {remote_host}
			ipv6_prefix 64
			events {$CADDY_STRICT_RATE_LIMIT_EVENTS:10}
			window {$CADDY_STRICT_RATE_LIMIT_WINDOW:1m}
		}

		# The contact form, which mails the operator for every submission.
		# The route rate-limits itself too (lib/rate-limit.ts); this stops a
		# flood before it reaches Node, or Redis.
		zone contact {
			match {
				method POST
				path /api/contact
			}
			key {remote_host}
			ipv6_prefix 64
			events {$CADDY_STRICT_RATE_LIMIT_EVENTS:10}
			window {$CADDY_STRICT_RATE_LIMIT_WINDOW:1m}
		}

		# Server actions: job submission (app/actions/jobs.ts, from the
		# dashboard) and the rest of app/actions — cancelling a job, starting
		# a checkout, signing out. Next sends each as a POST to the page it
		# was rendered on, carrying a Next-Action header whose value is a
		# per-build hash, so the header's presence is what is matched: no
		# path names an action, and the hash would change every deploy.
		zone server_actions {
			match {
				method POST
				header Next-Action *
			}
			key {remote_host}
			ipv6_prefix 64
			events {$CADDY_STRICT_RATE_LIMIT_EVENTS:10}
			window {$CADDY_STRICT_RATE_LIMIT_WINDOW:1m}
		}

		# Ingest sits between the two. The analytics proxy is anonymous and
		# forwards to PostHog on the operator's quota, so it is limited on
		# its own and kept out of the general budget. But posthog-js sends a
		# batch every few seconds while a page is in use, plus a flags call
		# on each load — a strict limit would drop real users' events — so
		# 120 a minute is several times that, and a fraction of a flood.
		zone ingest {
			match {
				path /ingest /ingest/*
			}
			key {remote_host}
			ipv6_prefix 64
			events {$CADDY_INGEST_RATE_LIMIT_EVENTS:120}
			window {$CADDY_INGEST_RATE_LIMIT_WINDOW:1m}
		}
	}

	# A refused request surfaces as an error, as an oversized body does, and
	# is marked the same way. Retry-After is already on the response; the
	# connection is left open, since the client did nothing wrong but go too
	# fast, and the next request on it may be inside the limit.
	handle_errors 429 {
		log_append blocked rate_limited
		respond 429
	}

	# ── Access log ──────────────────────────────────────────────────────────
	# One JSON object per request, written to /var/log/caddy inside the
	# container, which docker-compose.prod.yml bind-mounts from logs/caddy
	# beside the compose file so the host — and a ban jail on it — can read
	# it. Every request Caddy refused carries a `blocked` field ("scanner",
	# "body_too_large" or "rate_limited"); nothing else does. A 429 is a 4xx
	# like any other to the caddy-errors ban jail, so a client that keeps
	# running into its limit is eventually banned outright.
	#
	# Bounded on disk: the file rolls at 10 MiB and at most five rolled files
	# (gzipped) are kept, none older than 30 days. 0640 because the log holds
	# client addresses and full request URIs, sign-in links' tokens included.
	log {
		output file /var/log/caddy/access.log {
			mode 0640
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}

# Nothing is compressed here on purpose. Next.js compresses its own output
# (`compress` defaults to true), so an `encode` directive would only add a
# second pass over already-gzipped bytes — and compressing a stream is how the
# SSE job-progress endpoint stops arriving live.
