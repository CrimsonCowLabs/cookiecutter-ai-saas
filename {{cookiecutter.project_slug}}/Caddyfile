# Reverse proxy and TLS for {{ cookiecutter.project_name }}.
#
# Caddy runs inside docker-compose.prod.yml and is the only service that
# publishes ports, so `docker compose -f docker-compose.prod.yml up -d` is all
# it takes to serve HTTPS. Caddy obtains a certificate from Let's Encrypt on
# first boot, renews it before it expires, and redirects HTTP to HTTPS itself.
#
# Before the first deploy, point the domain's A/AAAA record at this host.
# Issuance is a challenge against that name, so it fails until DNS resolves and
# ports 80 and 443 reach this container.
{#- Every Jinja tag in this file trims its own newline (`{%-`, `-%}`). That is
    load-bearing, not tidiness: a bare `{% %}` leaves the blank line its tag
    occupied, and CI diffs the rendered file against `caddy fmt`, which rejects
    a stray blank line before the global block.

    The ACME account address is emitted only for an address that could actually
    receive mail. RFC 2606 reserves example.com/.org/.net and the .test,
    .invalid, .localhost and .example TLDs; a suffix test on "example.com"
    would also wrongly suppress a real domain like acme-example.com. -#}
{%- set _email = cookiecutter.author_email.strip() -%}
{%- set _domain = _email.rpartition('@')[2].lower() if '@' in _email else '' -%}
{%- set _reserved_domains = ('example.com', 'example.org', 'example.net') -%}
{%- set _reserved_tlds = ('test', 'invalid', 'localhost', 'example', 'local') -%}
{%- if _domain and '.' in _domain and _domain not in _reserved_domains and _domain.rpartition('.')[2] not in _reserved_tlds %}
{
	# ACME account address. The certificate authority mails renewal failures
	# and expiry warnings here; it is never served to anyone.
	email {{ cookiecutter.author_email }}
}
{%- else %}

# There is no ACME account address: the address answered at generation time is
# at a reserved example domain, so no mail can reach it and a certificate
# authority can reject one it cannot deliver to. Certificates are still issued — the account is simply anonymous,
# so nobody is told when renewal starts failing. Add a global block once you
# have a real address:
#
#     {
#         email you@your-real-domain.com
#     }
{%- endif %}

# The site this proxy serves, with a publicly trusted certificate:
#
#     https://{{ cookiecutter.domain_name }}
#
# SITE_ADDRESS overrides that name, which is how you smoke-test the stack before
# DNS exists: set it to https://localhost and Caddy issues from its own local CA
# rather than asking Let's Encrypt for a name that does not resolve yet.
# Everything else — the redirect, TLS termination, the proxy hop — is unchanged.
{$SITE_ADDRESS:https://{{ cookiecutter.domain_name }}} {
	# `app` is the compose service name and 3000 the port inside that
	# container. It publishes no host port, so this proxy is the only route in.
	# Caddy sets X-Forwarded-For/-Proto/-Host itself, which is what lets
	# NextAuth (trustHost: true in lib/auth.config.ts) build https:// callbacks.
	reverse_proxy app:3000

	# ── Scanner probes ──────────────────────────────────────────────────────
	# Bots walk every public address asking for leaked secrets and for admin
	# pages of software this app does not run. None of these paths can mean
	# anything to a Next.js app, so they are answered here — an empty 404, then
	# the connection is closed — and never cost the app a render or a log line.
	#
	# `*.php` covers most of WordPress on its own; the WordPress, phpMyAdmin
	# and CGI prefixes stay listed because they also catch the non-.php files
	# under them. Matching is case-insensitive, so /.ENV is blocked too.
	# Nothing here may overlap a real route: /.well-known/ (ACME, security.txt)
	# is deliberately absent, and a page whose path merely contains "php" or
	# "env" is not matched.
	@scanner path /.env* /.git /.git/* /.aws/* /.ssh/* /wp-login.php /wp-admin* /wp-content/* /wp-includes/* /xmlrpc.php /phpmyadmin* /pma/* /cgi-bin/* /server-status /server-info *.php
	handle @scanner {
		# The marker a ban jail matches on: `"blocked":"scanner"` in this
		# request's access-log line. A 404 alone would not do — the app
		# returns plenty of honest 404s.
		log_append blocked scanner
		respond 404 {
			close
		}
	}

	# ── Request body caps ───────────────────────────────────────────────────
	# Several route handlers read the whole body into memory before looking
	# at it (`req.json()`, `req.formData()`, `req.arrayBuffer()`), and some of
	# them take anonymous traffic. Caddy counts the bytes as they stream past
	# and answers 413 once a body goes over its cap, so an oversized upload
	# is refused before Node buffers it.
	#
	# Everything gets the generous cap. Nothing in the app accepts uploads;
	# the largest legitimate bodies are Stripe webhook events (well under a
	# megabyte) and server actions, which Next itself limits to 1 MB. Raise
	# this if you add file uploads, or give the upload route its own cap.
	request_body {
		max_size 10MB
	}

	# Small form posts get a tight cap. The contact form's longest valid
	# submission (a 5000-character message plus the other fields, see
	# lib/validations.ts) is around 20 KB even in four-byte UTF-8; the age
	# check posts a date and two short fields; one-click unsubscribe posts a
	# single fixed field. A route absent from this build (no contact form, say)
	# simply never matches.
	@small_form path /api/contact /api/age-check /api/unsubscribe
	request_body @small_form {
		max_size 64KB
	}

	# The analytics proxy (app/ingest/[...path]/route.ts) is unauthenticated
	# and forwards whatever it is sent. posthog-js posts batches of events,
	# compressed, and session recording is off (lib/analytics.ts), so a batch
	# stays far below this.
	@ingest path /ingest /ingest/*
	request_body @ingest {
		max_size 1MB
	}

	# A body cut off at its cap surfaces here as an error, not as a response
	# from the app, so this only ever fires for Caddy's own refusals: a 413
	# the app itself returned does not pass through it. It marks the line the
	# same way the scanner block does.
	handle_errors 413 {
		log_append blocked body_too_large
		respond 413 {
			close
		}
	}

	# ── Access log ──────────────────────────────────────────────────────────
	# One JSON object per request, written to /var/log/caddy inside the
	# container, which docker-compose.prod.yml bind-mounts from logs/caddy
	# beside the compose file so the host — and a ban jail on it — can read
	# it. Every request Caddy refused carries a `blocked` field ("scanner" or
	# "body_too_large"); nothing else does.
	#
	# Bounded on disk: the file rolls at 10 MiB and at most five rolled files
	# (gzipped) are kept, none older than 30 days. 0640 because the log holds
	# client addresses and full request URIs, sign-in links' tokens included.
	log {
		output file /var/log/caddy/access.log {
			mode 0640
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}

# Nothing is compressed here on purpose. Next.js compresses its own output
# (`compress` defaults to true), so an `encode` directive would only add a
# second pass over already-gzipped bytes — and compressing a stream is how the
# SSE job-progress endpoint stops arriving live.
