---
# Secrets the playbooks need. This file is the template; the real one is
# ansible/vault.yml, and it is encrypted:
#
#     cp ansible/vault.yml.example ansible/vault.yml
#     $EDITOR ansible/vault.yml            # fill in the values below
#     ansible-vault encrypt ansible/vault.yml
#
# Commit the encrypted ansible/vault.yml. It is ciphertext, and keeping it in
# the repository is what stops the one copy of these values from living on
# whichever laptop ran the playbook last. Never commit the password that opens
# it: put that in ansible/.vault-pass, which .gitignore already excludes, and
# point Ansible at it —
#
#     export ANSIBLE_VAULT_PASSWORD_FILE=ansible/.vault-pass
#
# — or pass --ask-vault-pass on every run. Change a value later with
# `ansible-vault edit ansible/vault.yml`, which never writes plaintext to disk.
#
# Every name here is prefixed `vault_`, so a variable that is a secret is
# recognisable as one at the point it is used. The playbooks refuse to run
# against a vault.yml that is not encrypted rather than quietly reading your
# credentials out of a plaintext file somebody may not have noticed.

# ─── Backups ───
# Read by ansible/backup.yml. Nothing about the schedule or the retention policy
# is here — those are decisions, not secrets, and they live in
# ansible/group_vars/all.yml.

# Where the dumps go. This is written verbatim into an rclone remote definition,
# so the keys are rclone's own config keys for whichever backend you pick
# (`rclone config` walks you through one interactively if you would rather see
# the options; `rclone config show` then prints the stanza to copy in here).
#
# The example is an S3-compatible bucket, which is what most object storage
# speaks — Backblaze B2, Cloudflare R2, Wasabi, DigitalOcean Spaces, Hetzner,
# MinIO, AWS itself. Any other rclone backend works without touching the
# playbook: swap the keys for that backend's (`type: b2` with `account` and
# `key`, `type: sftp` with `host`, `user` and `key_file`, and so on).
#
# Use a credential scoped to this one bucket. It is stored on the application
# host, so if the host is compromised so is the credential — and a credential
# that can only write and list one bucket cannot be used to empty the rest of
# your account. If your provider supports object lock or versioning, turn it on:
# the prune step below is the one thing in this design that deletes, and a
# write-only credential plus a locked bucket is what stops a compromised host
# from destroying the history it has been uploading.
#
# Values are written into the config file exactly as given. rclone stores some
# fields obscured rather than plain (an sftp `pass`, for one); for those, put
# the output of `rclone obscure <value>` here rather than the value itself.
vault_backup_remote:
  type: s3
  # "Other" works for most S3-compatible services. AWS, Minio, Wasabi,
  # Cloudflare, Alibaba, Ceph and others have their own value — `rclone help
  # backend s3` lists them, and naming yours turns on its quirks.
  provider: Other
  endpoint: ""
  region: ""
  access_key_id: ""
  secret_access_key: ""

# The bucket, and a prefix inside it, that dumps are written to. One prefix per
# application: the prune step deletes the oldest objects it finds under this
# path, so two stacks sharing a path would prune each other's backups.
vault_backup_remote_path: ""

# Where a failed backup is reported. Required: without it the only record of a
# failure is a journal entry on the host that failed, which nobody reads
# unprompted — so a backup that stopped working would look exactly like one that
# never did. Anything that accepts a POST will do; an incoming webhook from
# Slack, Discord, Mattermost or Google Chat, or an ntfy.sh topic, takes a minute
# to create. Match backup_alert_payload in group_vars/all.yml to whichever you
# pick. Treat the URL as a secret: it is a capability, not an address.
vault_backup_alert_url: ""

# Optional, and the only thing here that can tell you the host itself is gone.
# A URL pinged after every successful backup, for a dead-man's-switch service
# (healthchecks.io, Cronitor, an Uptime Kuma push monitor) that alerts when the
# ping stops arriving. The staleness check installed on the host covers a timer
# that stopped firing, but it cannot report a host that is powered off, out of
# disk or destroyed — by then nothing on it runs. Leave empty to skip the ping.
vault_backup_heartbeat_url: ""
