# .env-production for __PROJECT_NAME__, rendered on the host by
# ansible/deploy.yml. Edits here are overwritten by the next deploy.
#
# The compose file's own variables, and nothing any container is handed. Every
# `docker compose` command on the host passes this file as --env-file, and
# compose reads it to fill in docker-compose.prod.yml: the postgres service's
# superuser, and the caddy service's pass-through settings. It is no service's
# env_file. Each of app, worker, db-writer and ops has a file of its own beside
# this one (.env-app, .env-worker, ...; see env-app.j2 and its siblings),
# holding only what that service's code reads, so that a compromised worker —
# the container that runs a model's tool calls against URLs users supply —
# does not hold the Stripe key, the session secret or the database password
# along with it. tests/deploy/service-env.test.mjs holds every one of those
# files, and this one, to that.
#
# Secrets come from ansible/vault.yml (encrypted in the repository); the rest
# come from ansible/group_vars/all.yml or from the defaults written into this
# template at generation time. A value that differs between hosts belongs in
# group_vars; a value that must not be readable belongs in the vault. Nothing
# belongs here.

# ─── Database ─────────────────────────────────────────
# The superuser's, interpolated into the postgres service, which initialises
# its data directory with them. Nothing in the stack connects with them: the
# containers that use the database have the app role's DATABASE_URL in their
# own files, and the migrator has the schema owner's in .env-migrations. Since
# no container is handed this file, the superuser's password is now in no
# environment but Postgres's own.
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
{#
  Caddy's settings, read by the compose file's pass-through of each name into
  the caddy service. Each is written only when group_vars sets it, because a
  line here with an empty value would still be set, and Caddy's
  {$NAME:default} falls back to its default only for a name that is unset.
  Compared with equalto rather than measured with length, because a limit set
  as a bare number in group_vars arrives as an int, which has none.
#}
{% set proxy_env = [
     ('SITE_ADDRESS', site_address | default('')),
     ('CADDY_RATE_LIMIT_EVENTS', caddy_rate_limit_events | default('')),
     ('CADDY_RATE_LIMIT_WINDOW', caddy_rate_limit_window | default('')),
     ('CADDY_STRICT_RATE_LIMIT_EVENTS', caddy_strict_rate_limit_events | default('')),
     ('CADDY_STRICT_RATE_LIMIT_WINDOW', caddy_strict_rate_limit_window | default('')),
     ('CADDY_INGEST_RATE_LIMIT_EVENTS', caddy_ingest_rate_limit_events | default('')),
     ('CADDY_INGEST_RATE_LIMIT_WINDOW', caddy_ingest_rate_limit_window | default('')),
   ] | rejectattr('1', 'equalto', '') | list %}
{% if proxy_env | length > 0 %}

# ─── Proxy ────────────────────────────────────────────
# Read by Caddy: the name it serves and its per-address rate limits. Only the
# ones set in ansible/group_vars/all.yml are here; for the rest, the
# Caddyfile's own default applies.
{% for name, value in proxy_env %}
{{ name }}={{ value }}
{% endfor %}
{% endif %}
