# .env-app for __PROJECT_NAME__, rendered on the host by ansible/deploy.yml and
# handed to the app container alone (docker-compose.prod.yml's env_file). Edits
# here are overwritten by the next deploy.
#
# Exactly what the Next.js app reads, and no more. The app is the one service
# that needs the account's keys — it signs sessions, talks to Stripe, sends
# mail — so most secrets are here; the worker's model credentials are not,
# because nothing in the app calls a model. tests/deploy/service-env.test.mjs
# fails if a name is added here that the app's code does not read, or if the
# app reads a setting the deploy renders only for another service.
#
# Secrets come from ansible/vault.yml; the rest from ansible/group_vars/all.yml
# or from defaults written in here at generation time. PORT, HOSTNAME and
# NODE_ENV are not here because the image sets them (see the Dockerfile's
# runner stage).

# ─── Auth ──────────────────────────────────────────────────────────────
NEXTAUTH_URL={{ nextauth_url }}
NEXTAUTH_SECRET={{ vault_nextauth_secret }}
# cc:begin google
GOOGLE_ID={{ vault_google_id | default('') }}
GOOGLE_SECRET={{ vault_google_secret | default('') }}
# cc:end google
# cc:begin microsoft
MICROSOFT_ENTRA_ID_ID={{ vault_microsoft_entra_id_id | default('') }}
MICROSOFT_ENTRA_ID_SECRET={{ vault_microsoft_entra_id_secret | default('') }}
MICROSOFT_ENTRA_ID_TENANT_ID={{ vault_microsoft_entra_id_tenant_id | default('') }}
# cc:end microsoft

# ─── Database and queue ───────────────────────────────
# The app role's connection (see app_database_url in deploy.yml): rows, and
# nothing else. Redis carries the job queue and the rate limits.
DATABASE_URL={{ app_database_url }}
REDIS_URL={{ redis_url }}
# cc:begin stripe

# ─── Stripe ───────────────────────────────────────────
# Only the server-side two: nothing in the app reads a publishable key, since
# checkout is a redirect to a Stripe-hosted page.
STRIPE_SECRET_KEY={{ vault_stripe_secret_key | default('') }}
STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret | default('') }}
# cc:end stripe
# cc:begin resend

# ─── Resend (Email: magic link sign-in, contact form, subscription acknowledgment) ─
RESEND_API_KEY={{ vault_resend_api_key | default('') }}
# cc:end resend
# cc:begin analytics

# ─── Analytics (PostHog, only with the visitor's consent) ─
# Empty key = no consent banner and no analytics. For an EU project, set
# posthog_host and posthog_assets_host (with -e or in group_vars/all.yml) to
# https://eu.i.posthog.com and https://eu-assets.i.posthog.com.
POSTHOG_KEY={{ vault_posthog_key | default('') }}
POSTHOG_HOST={{ posthog_host | default('https://us.i.posthog.com') }}
POSTHOG_ASSETS_HOST={{ posthog_assets_host | default('https://us-assets.i.posthog.com') }}
# cc:end analytics

# ─── Content-Security-Policy ─────────────────────────
# false enforces the policy (lib/csp.ts). true only reports what it would
# block, to try a new third-party origin in production before enforcing it:
# deploy with -e csp_report_only=true, then again without. See
# docs/content-security-policy.md.
CSP_REPORT_ONLY={{ csp_report_only | default('false') }}

# ─── Feature Flags ───────────────────────────────────
# lib/feature-flags.ts: a flag left out here takes the default written there.
FEATURE_EMAIL_NOTIFICATIONS=false
