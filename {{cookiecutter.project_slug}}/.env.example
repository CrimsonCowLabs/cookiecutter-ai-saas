# ─── Auth ──────────────────────────────────────────────
# Production: https://{{ cookiecutter.domain_name }}
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
HOSTNAME=0.0.0.0

# cc:begin google
# Google OAuth
GOOGLE_ID=
GOOGLE_SECRET=

# cc:end google
# cc:begin microsoft
# Microsoft Entra ID (Azure AD) OAuth
MICROSOFT_ENTRA_ID_ID=
MICROSOFT_ENTRA_ID_SECRET=
MICROSOFT_ENTRA_ID_TENANT_ID=

# cc:end microsoft

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:{{ cookiecutter.postgres_port }}/{{ cookiecutter.project_slug | replace('-', '_') }}

# ─── Redis (BullMQ) ──────────────────────────────────
REDIS_URL=redis://localhost:{{ cookiecutter.redis_port }}

# ─── Stripe ───────────────────────────────────────────
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# cc:begin resend
# ─── Resend (Email: magic link sign-in, contact form) ─
RESEND_API_KEY=
# cc:end resend

# ─── LLM Provider ──────────────────────────────────
# Options: "ollama", "openai", "anthropic", "openrouter"
LLM_PROVIDER={{ cookiecutter.llm_provider }}

# Only the provider answered at generation time is here. The worker reads all
# four with defaults, so switching later means adding that provider's variables
# back and changing LLM_PROVIDER above — not changing any code.
# cc:begin llm-ollama
# ─── Ollama ──────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=
# cc:end llm-ollama
# cc:begin llm-openai
# ─── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=
# cc:end llm-openai
# cc:begin llm-anthropic
# ─── Anthropic ──────────────────────────────────
ANTHROPIC_API_KEY=
# cc:end llm-anthropic
# cc:begin llm-openrouter
# ─── OpenRouter ─────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# cc:end llm-openrouter

# ─── AI step agent ────────────────────────────────────
# Max tool calls the AI step's agent may make per job (the loop bound).
RESEARCH_MAX_TOOL_CALLS=8

# ─── Tracing (LangSmith, optional) ───────────────────
# Off unless LANGSMITH_TRACING is true AND LANGSMITH_API_KEY is set. Turning it
# on sends your users' prompts and the model's completions to the collector
# below, so opt in deliberately. Traces are labelled with job id, job type and
# user. The worker never fails a job over tracing: a missing key or an
# unreachable collector costs a log line.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Empty = the hosted collector, https://api.smith.langchain.com
# Self-hosted: your own instance's API URL, e.g. http://langsmith.internal:8000/api
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT={{ cookiecutter.project_slug }}

# ─── Feature Flags ───────────────────────────────────
FEATURE_SCHEDULED_TASKS=false
FEATURE_EMAIL_NOTIFICATIONS=false
