# ─── Auth ──────────────────────────────────────────────
# Production: https://{{ cookiecutter.domain_name }}
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
HOSTNAME=0.0.0.0

# cc:begin google
# Google OAuth
GOOGLE_ID=
GOOGLE_SECRET=

# cc:end google
# cc:begin microsoft
# Microsoft Entra ID (Azure AD) OAuth
MICROSOFT_ENTRA_ID_ID=
MICROSOFT_ENTRA_ID_SECRET=
MICROSOFT_ENTRA_ID_TENANT_ID=

# cc:end microsoft

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:{{ cookiecutter.postgres_port }}/{{ cookiecutter.project_slug | replace('-', '_') }}

# ─── Redis (BullMQ) ──────────────────────────────────
REDIS_URL=redis://localhost:{{ cookiecutter.redis_port }}

# ─── Stripe ───────────────────────────────────────────
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Resend (Email) ──────────────────────────────────
RESEND_API_KEY=

# ─── LLM Provider ──────────────────────────────────
# Options: "ollama", "openai", "anthropic", "openrouter"
LLM_PROVIDER={{ cookiecutter.llm_provider }}

# ─── Ollama ──────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# ─── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=

# ─── Anthropic ──────────────────────────────────
ANTHROPIC_API_KEY=

# ─── OpenRouter ─────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Feature Flags ───────────────────────────────────
FEATURE_SCHEDULED_TASKS=false
FEATURE_EMAIL_NOTIFICATIONS=false
